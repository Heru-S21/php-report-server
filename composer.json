{
    "name": "reporting-engine/php-reporting-engine",
    "description": "PHP Reporting Engine - Self-contained web reporting application",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "mpdf/mpdf": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "picqer/php-barcode-generator": "^3.2",
        "phenx/php-font-lib": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ReportingEngine\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
